# Application under test
BASE_URL=https://www.saucedemo.com
BROWSER=chrome
HEADLESS=true
# Explicit-wait timeout in seconds
TIMEOUT=10

# AI Test Assistant (optional). anthropic | openai | none
AI_PROVIDER=none
# Model id for the chosen provider, e.g. claude-opus-5-5 (anthropic) or gpt-4o (openai)
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Max AI calls per run, shared by triage, healing and visual checks
AI_MAX_CALLS=20
